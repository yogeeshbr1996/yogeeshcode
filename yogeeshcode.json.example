{
  "$schema": "https://opencode.ai/config.json",
  "theme": "yogeeshcode",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, free, unlimited)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen2.5-coder:14b": { "name": "Qwen2.5-Coder 14B (local fallback)", "limit": { "context": 32768, "output": 8192 } },
        "qwen3-coder:30b": { "name": "Qwen3-Coder 30B (local best)", "limit": { "context": 64000, "output": 16000 } }
      }
    },
    "openrouter-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter free endpoints ($0)",
      "options": { "baseURL": "https://openrouter.ai/api/v1", "apiKey": "{env:OPENROUTER_API_KEY}" },
      "models": {
        "nex-agi/Nex-N2.5-Pro:free": { "name": "Nex Pro free (agentic coding)", "limit": { "context": 262144, "output": 16000 } },
        "deepseek/deepseek-chat:free": { "name": "DeepSeek free (executor)", "limit": { "context": 128000, "output": 8000 } },
        "qwen/qwen3-coder:free": { "name": "Qwen3-Coder free", "limit": { "context": 128000, "output": 12000 } }
      }
    }
  },
  "agent": {
    "plan": { "model": "gemini/gemini-2.5-flash", "description": "YogeeshCode planner - free tier, big context" },
    "build": { "model": "openrouter-free/nex-agi/Nex-N2.5-Pro:free", "description": "YogeeshCode builder - free, fallback to ollama local" }
  }
}
