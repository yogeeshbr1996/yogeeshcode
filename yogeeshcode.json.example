{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "YogeeshCode ships FREE-MODEL-ONLY by default. All ranked models are $0.",
  "theme": "yogeeshcode",
  "model": "gemini-free/gemini-2.5-flash",
  "small_model": "gemini-free/gemini-2.0-flash",
  "provider": {
    "gemini-free": {
      "npm": "@ai-sdk/google",
      "name": "Gemini free tier (best planner, 1M ctx)",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (free, 1M)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gemini-2.0-flash": {
          "name": "Gemini 2.0 Flash (free, 1M)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (free tier)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "openrouter-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter free ($0, auto-rotate)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "nex-agi/nex-n2.5-pro:free": {
