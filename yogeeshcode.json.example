{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "YogeeshCode ships FREE-MODEL-ONLY by default. All ranked models are $0. Deep-researched: Gemini, OpenRouter, Groq, Ollama, Together, DeepInfra, HuggingFace, Fireworks, Cohere, NVIDIA, Lepton, Baseten, Cerebras, Perplexity, Cloudflare, Mistral, Novita, Poe, watsonx, Vertex AI, SambaNova, Friendli, Predibase, Cortex.",
  "theme": "yogeeshcode",
  "model": "gemini-free/gemini-2.5-flash",
  "small_model": "gemini-free/gemini-2.0-flash",
  "provider": {
    "gemini-free": {
      "npm": "@ai-sdk/google",
      "name": "Gemini free tier (best planner, 1M ctx)",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (free, 1M)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gemini-2.0-flash": {
