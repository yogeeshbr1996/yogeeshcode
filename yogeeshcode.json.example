{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "YogeeshCode: FREE cloud models only (no local/ollama - machine-safe). Autopilot: edits + safe terminal commands auto-approved; only risky ops ask/deny. CLI flag: yogeeshcode --auto approves all except explicit deny.",
  "theme": "yogeeshcode",
  "model": "gemini-free/gemini-2.5-flash",
  "small_model": "gemini-free/gemini-2.0-flash",
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow", "cat*": "allow", "head*": "allow", "tail*": "allow", "wc*": "allow",
      "pwd": "allow", "echo*": "allow", "which*": "allow", "file*": "allow",
      "grep*": "allow", "rg*": "allow", "find*": "allow", "fd*": "allow",
      "git status*": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow",
      "git branch*": "allow", "git add*": "allow", "git commit*": "allow", "git stash*": "allow",
      "git checkout*": "allow", "git fetch*": "allow",
      "npm *": "allow", "npx *": "allow", "bun *": "allow", "node *": "allow", "tsc*": "allow",
      "eslint*": "allow", "prettier*": "allow", "biome*": "allow", "vitest*": "allow", "jest*": "allow",
      "python3 *": "allow", "python *": "allow", "pip *": "allow", "pytest*": "allow", "ruff*": "allow",
      "cargo *": "allow", "go *": "allow", "make*": "allow", "mkdir*": "allow", "touch*": "allow",
      "cp*": "allow", "mv*": "allow",
      "rm -rf*": "deny", "rm -fr*": "deny",
      "git push*": "ask", "git reset --hard*": "deny", "git clean*": "deny", "git rebase*": "ask",
      "sudo *": "deny", "chmod 777*": "deny", "kill*": "ask", "docker *": "ask",
      "curl *": "ask", "wget *": "ask", "ssh *": "deny", "brew *": "ask"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "provider": {
    "opencode": {
      "name": "OpenCode Zen - OUR OWN free tier (31 free models, auth via: yogeeshcode auth login - device OAuth, NO API key)",
      "models": {
        "big-pickle": { "name": "Zen big-pickle - flagship free coder, 200K", "limit": { "context": 200000, "output": 32000 } },
        "grok-code": { "name": "Zen grok-code - free agentic coder, 256K", "limit": { "context": 256000, "output": 16000 } },
        "nemotron-3-ultra-free": { "name": "Zen Nemotron 3 Ultra - free, 1M ctx", "limit": { "context": 1000000, "output": 32000 } },
        "qwen3.6-plus-free": { "name": "Zen Qwen3.6 Plus - free, 262K", "limit": { "context": 262144, "output": 16000 } },
        "minimax-m2.1-free": { "name": "Zen MiniMax M2.1 - free, 204K", "limit": { "context": 204800, "output": 16000 } },
        "deepseek-v4-flash-free": { "name": "Zen DeepSeek V4 Flash - free, 200K", "limit": { "context": 200000, "output": 16000 } },
        "glm-5-free": { "name": "Zen GLM-5 - free, 204K", "limit": { "context": 204800, "output": 16000 } },
        "kimi-k2.5-free": { "name": "Zen Kimi K2.5 - free, 262K", "limit": { "context": 262144, "output": 16000 } },
        "longcat-2.0-free": { "name": "Zen LongCat 2.0 - free, 1M ctx", "limit": { "context": 1000000, "output": 32000 } },
        "mimo-v2-pro-free": { "name": "Zen MiMo V2 Pro - free, 1M ctx", "limit": { "context": 1048576, "output": 32000 } },
        "ling-3.0-flash-free": { "name": "Zen Ling 3.0 Flash - free, 262K", "limit": { "context": 262144, "output": 16000 } },
        "muse-spark-1.3-contributor-free": { "name": "Zen Muse Spark 1.3 contributor - free, 1M ctx", "limit": { "context": 1048576, "output": 32000 } },
        "glm-4.7-free": { "name": "Zen GLM-4.7 - free, 204K", "limit": { "context": 204800, "output": 16000 } },
        "nemotron-3-super-free": { "name": "Zen Nemotron 3 Super - free, 204K", "limit": { "context": 204800, "output": 16000 } },
        "minimax-m2.5-free": { "name": "Zen MiniMax M2.5 - free, 204K", "limit": { "context": 204800, "output": 16000 } },
        "minimax-m3-free": { "name": "Zen MiniMax M3 - free, 200K", "limit": { "context": 200000, "output": 16000 } }
      }
    },
    "gemini-free": {
      "npm": "@ai-sdk/google",
      "name": "Google AI Studio free tier (key: aistudio.google.com)",
      "options": { "apiKey": "{env:GEMINI_API_KEY}" },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash - rank 1, 1M ctx", "limit": { "context": 1000000, "output": 65536 } },
        "gemini-2.0-flash": { "name": "Gemini 2.0 Flash - fallback, 1M ctx", "limit": { "context": 1000000, "output": 8192 } },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro - best quality free tier", "limit": { "context": 1000000, "output": 65536 } }
      }
    },
    "glm-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zhipu GLM - 100% free flagship (key: open.bigmodel.cn)",
      "options": { "baseURL": "https://open.bigmodel.cn/api/paas/v4", "apiKey": "{env:GLM_API_KEY}" },
      "models": {
        "glm-4.5-flash": { "name": "GLM-4.5-Flash - 100% free, good agentic coding", "limit": { "context": 128000, "output": 16000 } },
        "glm-4-flash": { "name": "GLM-4-Flash - 100% free forever", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "openrouter-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter :free - $0 (key: openrouter.ai; 50 req/day, 1000/day if ever bought $10 credit)",
      "options": { "baseURL": "https://openrouter.ai/api/v1", "apiKey": "{env:OPENROUTER_API_KEY}" },
      "models": {
        "nex-agi/nex-n2.5-pro:free": { "name": "Nex N2.5 Pro - agentic coding tuned, 262K", "limit": { "context": 262144, "output": 16000 } },
        "nex-agi/nex-n2.5-mini:free": { "name": "Nex N2.5 Mini - agentic, 262K", "limit": { "context": 262144, "output": 16000 } },
        "qwen/qwen3-coder:free": { "name": "Qwen3 Coder - purpose-built coder, 128K", "limit": { "context": 131072, "output": 12000 } },
        "deepseek/deepseek-chat-v3.1:free": { "name": "DeepSeek V3.1 - strong executor, 128K", "limit": { "context": 131072, "output": 8000 } },
        "deepseek/deepseek-r1:free": { "name": "DeepSeek R1 - reasoning, 128K", "limit": { "context": 131072, "output": 8000 } },
        "z-ai/glm-4.5-air:free": { "name": "GLM 4.5 Air - coding, 128K", "limit": { "context": 131072, "output": 12000 } },
        "meta-llama/llama-3.3-70b-instruct:free": { "name": "Llama 3.3 70B - general, 128K", "limit": { "context": 131072, "output": 8000 } },
        "qwen/qwen3-235b-a22b:free": { "name": "Qwen3 235B - MoE reasoning, 128K", "limit": { "context": 131072, "output": 12000 } },
        "mistralai/mistral-small-3.2-24b-instruct:free": { "name": "Mistral Small 3.2 - fast, 128K", "limit": { "context": 131072, "output": 8000 } },
        "moonshotai/kimi-k2:free": { "name": "Kimi K2 - long context agentic, 200K", "limit": { "context": 200000, "output": 12000 } },
        "tngtech/deepseek-r1t2-chimera:free": { "name": "DeepSeek R1T2 Chimera - fast reasoning", "limit": { "context": 131072, "output": 8000 } }
      }
    },
    "github-models": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Models - free with your GitHub PAT, no extra signup (github.com/settings/tokens)",
      "options": { "baseURL": "https://models.github.ai/inference", "apiKey": "{env:GITHUB_PAT}" },
      "models": {
        "openai/gpt-4o-mini": { "name": "GPT-4o mini - solid coding, 128K", "limit": { "context": 128000, "output": 16384 } },
        "openai/gpt-4.1-mini": { "name": "GPT-4.1 mini - newer, strong coding", "limit": { "context": 128000, "output": 16384 } },
        "meta-llama/Llama-3.3-70B-Instruct": { "name": "Llama 3.3 70B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "deepseek/DeepSeek-V3-0324": { "name": "DeepSeek V3 - 128K", "limit": { "context": 128000, "output": 8000 } },
        "mistral-ai/Mistral-Small-24B-Instruct-2501": { "name": "Mistral Small 24B - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "groq-free": {
      "npm": "@ai-sdk/groq",
      "name": "Groq - free tier, fastest inference (key: console.groq.com, ~30 RPM)",
      "options": { "apiKey": "{env:GROQ_API_KEY}" },
      "models": {
        "llama-3.3-70b-versatile": { "name": "Llama 3.3 70B - fast executor, 128K", "limit": { "context": 131072, "output": 32768 } },
        "qwen-qwq-32b": { "name": "QwQ 32B - reasoning, 128K", "limit": { "context": 131072, "output": 16000 } },
        "llama-3.1-8b-instant": { "name": "Llama 3.1 8B - instant, small tasks", "limit": { "context": 131072, "output": 8192 } }
      }
    },
    "cerebras-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras - free tier, fastest tokens/sec (key: cloud.cerebras.ai, 1M tokens/day)",
      "options": { "baseURL": "https://api.cerebras.ai/v1", "apiKey": "{env:CEREBRAS_API_KEY}" },
      "models": {
        "llama-3.3-70b": { "name": "Llama 3.3 70B - very fast, 128K", "limit": { "context": 128000, "output": 8000 } },
        "qwen-3-32b": { "name": "Qwen3 32B - reasoning, fast", "limit": { "context": 128000, "output": 8000 } },
        "llama-4-scout-17b-16e-instruct": { "name": "Llama 4 Scout - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },

    "mistral-free": {
      "npm": "@ai-sdk/mistral",
      "name": "Mistral La Plateforme - Experiment plan free (key: console.mistral.ai)",
      "options": { "apiKey": "{env:MISTRAL_API_KEY}" },
      "models": {
        "mistral-small-latest": { "name": "Mistral Small 3.x - free tier, 128K", "limit": { "context": 128000, "output": 8000 } },
        "codestral-latest": { "name": "Codestral - code-specialized, 256K", "limit": { "context": 256000, "output": 8000 } }
      }
    },
    "modelscope-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ModelScope - 2000 free calls/day (key: modelscope.cn, hosts Qwen official)",
      "options": { "baseURL": "https://api-inference.modelscope.cn/v1", "apiKey": "{env:MODELSCOPE_API_KEY}" },
      "models": {
        "Qwen/Qwen3-Coder-480B-A35B-Instruct": { "name": "Qwen3 Coder 480B - flagship coder, 256K", "limit": { "context": 256000, "output": 16000 } },
        "Qwen/Qwen2.5-Coder-32B-Instruct": { "name": "Qwen2.5 Coder 32B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "deepseek-ai/DeepSeek-V3": { "name": "DeepSeek V3 - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM - ~1000 free credits (key: build.nvidia.com)",
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "{env:NVIDIA_API_KEY}" },
      "models": {
        "meta/llama-3.3-70b-instruct": { "name": "Llama 3.3 70B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "deepseek-ai/deepseek-r1": { "name": "DeepSeek R1 - reasoning, 128K", "limit": { "context": 128000, "output": 8000 } },
        "qwen/qwen2.5-coder-32b-instruct": { "name": "Qwen2.5 Coder 32B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "nvidia/llama-3.1-nemotron-70b-instruct": { "name": "Nemotron 70B - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "cohere-free": {
      "npm": "@ai-sdk/cohere",
      "name": "Cohere trial key - 1000 calls/month free (key: dashboard.cohere.com)",
      "options": { "apiKey": "{env:COHERE_API_KEY}" },
      "models": {
        "command-r-plus-08-2024": { "name": "Command R+ - agentic coding, 128K", "limit": { "context": 128000, "output": 8000 } },
        "command-r-08-2024": { "name": "Command R - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "huggingface-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HuggingFace Inference - small free monthly credits (key: hf.co/settings/tokens)",
      "options": { "baseURL": "https://router.huggingface.co/v1", "apiKey": "{env:HF_API_KEY}" },
      "models": {
        "Qwen/Qwen2.5-Coder-32B-Instruct": { "name": "Qwen2.5 Coder 32B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "meta-llama/Llama-3.3-70B-Instruct": { "name": "Llama 3.3 70B - 128K", "limit": { "context": 128000, "output": 8000 } },
        "deepseek-ai/DeepSeek-V3-0324": { "name": "DeepSeek V3 - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    },
    "cloudflare-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloudflare Workers AI - 10K neurons/day free (key: dash.cloudflare.com, replace YOUR_ACCOUNT_ID)",
      "options": { "baseURL": "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1", "apiKey": "{env:CF_API_KEY}" },
      "models": {
        "@cf/meta/llama-3.3-70b-instruct-fp8-fast": { "name": "Llama 3.3 70B fast - 128K", "limit": { "context": 128000, "output": 8000 } },
        "@cf/meta/llama-3.1-8b-instruct-fp8": { "name": "Llama 3.1 8B - 128K", "limit": { "context": 128000, "output": 8000 } }
      }
    }
  },
  "yogeeshcode": {
    "free_models_only": true,
    "model_ranker": {
      "auto": true,
      "order": [
        "opencode/big-pickle",
        "gemini-free/gemini-2.5-flash",
        "opencode/grok-code",
        "opencode/nemotron-3-ultra-free",
        "opencode/qwen3.6-plus-free",
        "opencode/minimax-m2.1-free",
        "opencode/deepseek-v4-flash-free",
        "glm-free/glm-4.5-flash",
        "modelscope-free/Qwen/Qwen3-Coder-480B-A35B-Instruct",
        "github-models/openai/gpt-4o-mini",
        "openrouter-free/nex-agi/nex-n2.5-pro:free",
        "openrouter-free/qwen/qwen3-coder:free",
        "openrouter-free/deepseek/deepseek-chat-v3.1:free",
        "openrouter-free/z-ai/glm-4.5-air:free",
        "groq-free/llama-3.3-70b-versatile",
        "groq-free/qwen-qwq-32b",
        "cerebras-free/llama-3.3-70b",
        "cerebras-free/qwen-3-32b",
        "mistral-free/codestral-latest",
        "mistral-free/mistral-small-latest",
        "nvidia-nim/qwen/qwen2.5-coder-32b-instruct",
        "cohere-free/command-r-plus-08-2024",
        "huggingface-free/Qwen/Qwen2.5-Coder-32B-Instruct",
        "cloudflare-free/@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      ],
      "cooldown_ms": 60000,
      "max_attempts": 100
    }
  },
  "agent": {
    "plan": { "model": "opencode/big-pickle", "description": "YogeeshCode planner - Zen big-pickle free flagship (yogeeshcode auth login)" },
    "build": { "model": "opencode/big-pickle", "description": "YogeeshCode builder - Zen free, falls through 23 ranked free models on rate limits" }
  }
}

